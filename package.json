{
  "name": "metaontic-agent-forge",
  "version": "1.0.0",
  "description": "云智工坊 · 智能体平台：为 DeepSeek Harness 提供总控调度、专业 Agent 与可扩展业务模块，内置视频创作与宣传视频工作流。",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "keywords": [
    "metaontic-agent-forge",
    "deepseek-harness",
    "dsh-plugin",
    "agent-platform",
    "agent-orchestration",
    "multi-agent",
    "ai-video",
    "seedance",
    "long-video",
    "ffmpeg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-agent-forge.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-agent-forge#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-agent-forge/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./presets/forge-video-director": "./presets/forge-video-director.js",
    "./presets/forge-video-director/locale/*.json": "./locale/presets/forge-video-director/*.json",
    "./presets/forge-promo-video": "./presets/forge-promo-video.js",
    "./presets/forge-promo-video/locale/*.json": "./locale/presets/forge-promo-video/*.json",
    "./presets/forge-video-director/icon": "./presets/icons/forge-video-director.svg",
    "./presets/forge-promo-video/icon": "./presets/icons/forge-promo-video.svg",
    "./presets/forge-studio": "./presets/forge-studio.js",
    "./presets/forge-studio/locale/*.json": "./locale/presets/forge-studio/*.json",
    "./presets/forge-studio/icon": "./presets/icons/forge-studio.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.en.md",
    "MetaOnticAgentForge使用说明书.md",
    "MetaOnticAgentForge使用说明书.pdf",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "presets/*.js",
    "locale/presets/**/*.json",
    "presets/icons/*.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "hyperframes": "0.8.223",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "node scripts/build.mjs locale",
    "build:host": "node scripts/build.mjs host",
    "build:client": "node scripts/build.mjs client",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "release": "node scripts/release.mjs",
    "clean:releases": "node scripts/clean-releases.mjs",
    "pack:test": "node scripts/pack-test.mjs"
  },
  "dependencies": {},
  "releaseNotes": {
    "version": "1.0.0",
    "prerelease": false,
    "publishedAt": "2026-11-08T08:28:33.088Z",
    "items": [
      "优化：常规体验优化。"
    ]
  }
}
