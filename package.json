{
  "name": "metaontic-video",
  "version": "3.20.2",
  "description": "DeepSeek Harness video plugin: beginner-friendly guided video creation and a low-cost long-video workflow using segment continuation and local merging.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "keywords": [
    "metaontic-video",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "ai-video",
    "ai-video-generation",
    "seedance",
    "seedance-2",
    "long-video",
    "video-generation",
    "image-to-video",
    "text-to-video",
    "video-continuation",
    "video-extension",
    "storyboard",
    "ffmpeg",
    "new-api",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-agent-forge.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-agent-forge#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-agent-forge/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./presets/video-director": "./presets/video-director.js",
    "./presets/video-director/locale/*.json": "./locale/presets/video-director/*.json",
    "./presets/promo-video": "./presets/promo-video.js",
    "./presets/promo-video/locale/*.json": "./locale/presets/promo-video/*.json",
    "./presets/video-director/icon": "./presets/icons/video-director.svg",
    "./presets/promo-video/icon": "./presets/icons/promo-video.svg",
    "./presets/cloud-studio": "./presets/cloud-studio.js",
    "./presets/cloud-studio/locale/*.json": "./locale/presets/cloud-studio/*.json",
    "./presets/cloud-studio/icon": "./presets/icons/cloud-studio.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.en.md",
    "MetaOnticVideo使用说明书.md",
    "MetaOnticVideo使用说明书.pdf",
    "CHANGELOG.md",
    "LICENSE",
    "docs/guide/*.svg",
    "docs/guide/*.png",
    "THIRD_PARTY_NOTICES.md",
    "presets/*.js",
    "locale/presets/**/*.json",
    "presets/icons/*.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "hyperframes": "0.8.223",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "node scripts/build.mjs locale",
    "build:host": "node scripts/build.mjs host",
    "build:client": "node scripts/build.mjs client",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "release": "node scripts/release.mjs",
    "clean:releases": "node scripts/clean-releases.mjs",
    "pack:test": "node scripts/pack-test.mjs"
  },
  "dependencies": {},
  "releaseNotes": {
    "version": "3.20.2",
    "prerelease": false,
    "publishedAt": "2026-11-08T03:02:31.736Z",
    "items": [
      "优化：常规体验优化。"
    ]
  }
}
