{
  "name": "metaontic-video",
  "version": "3.12.0",
  "description": "AI video creation plugin for DeepSeek Harness: Seedance 2.0 long videos with multi-segment continuation, text-to-video, image-to-video, script and storyboard review, segment previews, resumable generation and local FFmpeg merging.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "metaontic-video",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "ai-video",
    "ai-video-generation",
    "seedance",
    "seedance-2",
    "long-video",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "video-continuation",
    "video-extension",
    "storyboard",
    "ffmpeg",
    "new-api",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "README.en.md",
    "MetaOnticVideo使用说明书.md",
    "MetaOnticVideo使用说明书.pdf",
    "CHANGELOG.md",
    "LICENSE",
    "docs/guide/*.svg",
    "docs/guide/*.png",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "hyperframes": "0.8.223",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "esbuild scripts/build-locale.ts --format=esm --platform=node --packages=external --outfile=node_modules/.cache/build-locale.mjs --log-level=warning && node node_modules/.cache/build-locale.mjs",
    "build:host": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --define:__PLUGIN_VERSION__=$(node -p 'JSON.stringify(require(\"./package.json\").version)') --outfile=index.js",
    "build:client": "esbuild src/client.ts --bundle --format=iife --platform=browser --target=es2022 --define:__PLUGIN_VERSION__=$(node -p 'JSON.stringify(require(\"./package.json\").version)') --outfile=client.js",
    "build": "npm run typecheck && npm run build:locale && npm run build:host && npm run build:client",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {},
  "releaseNotes": {
    "version": "3.12.0",
    "prerelease": false,
    "publishedAt": "2026-11-02T01:24:31Z",
    "items": [
      "新增：纯文生视频先询问是否生成角色参考图，明确图片单独计费；同意后使用Seedream按文字生成，展示审核通过才用于首段及续拍，拒绝则保留纯文生方案。",
      "新增：续拍持续携带最初角色参考图，支持明确指定角色图并默认沿用首段参考图或首帧；归一化结果随断点保存，后续分段及恢复继续使用同一套图。",
      "优化：角色图转换经同意、结果审核并成功重试后，后续续拍复用获审转换图，不重复出图；已提交任务保留原请求，避免恢复时重复提交。",
      "优化：同步中英文说明、角色图选择与审核步骤、安装排查及第三方许可声明。",
      "修复：宿主入口内置schemastery及其运行依赖，成品包不再依赖外部node_modules，修复卸载重装或在线更新后缺少Schema依赖导致插件启动失败的问题。",
      "修复：图片付费确认异常时停止出图；火山直连明确提示当前图片通道限制，不错误承诺可生成角色图。"
    ]
  }
}
