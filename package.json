{
  "name": "metaontic-video",
  "version": "3.13.10",
  "description": "AI video creation plugin for DeepSeek Harness: Seedance 2.0 long videos with multi-segment continuation, text-to-video, image-to-video, script and storyboard review, segment previews, resumable generation and local FFmpeg merging.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "metaontic-video",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "ai-video",
    "ai-video-generation",
    "seedance",
    "seedance-2",
    "long-video",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "video-continuation",
    "video-extension",
    "storyboard",
    "ffmpeg",
    "new-api",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "README.en.md",
    "MetaOnticVideo使用说明书.md",
    "MetaOnticVideo使用说明书.pdf",
    "CHANGELOG.md",
    "LICENSE",
    "docs/guide/*.svg",
    "docs/guide/*.png",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "hyperframes": "0.8.223",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "node scripts/build.mjs locale",
    "build:host": "node scripts/build.mjs host",
    "build:client": "node scripts/build.mjs client",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "release": "node scripts/release.mjs",
    "pack:test": "node scripts/pack-test.mjs"
  },
  "dependencies": {},
  "releaseNotes": {
    "version": "3.13.10",
    "prerelease": false,
    "publishedAt": "2026-11-03T00:52:29.659Z",
    "items": [
      "新增：新增测试包分发通道，在仓库执行 `npm run pack:test -- 版本号-后缀` 就会自动构建、运行单元测试、打出测试版 `.tgz`、上传到 `https://video.mybfs.cn/test/`，并核对线上文件与本地 sha256 一致后输出可直接转发的安装地址，未发布的改动可以先给他人试用。",
      "优化：测试包不占正式发布页，只改包内版本号，不提交、不打标签、不建 Release，核心版本号压在当前正式版之下，其他人仍会正常收到正式版更新提示；脚本结束后把包内版本号与构建产物还原为正式版本，不会把测试版本带进正式包。",
      "优化：README 发布章节与工程维护经验补充测试包通道的用法、线上目录和回退方式；`/test/` 目录禁止缓存与搜索引擎收录，测试者用正式版 `.tgz` 地址重装即可回到正式版。"
    ]
  }
}
