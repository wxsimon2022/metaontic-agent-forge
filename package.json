{
  "name": "metaontic-video",
  "version": "3.13.12",
  "description": "AI video creation plugin for DeepSeek Harness: Seedance 2.0 long videos with multi-segment continuation, text-to-video, image-to-video, script and storyboard review, segment previews, resumable generation and local FFmpeg merging.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "metaontic-video",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "ai-video",
    "ai-video-generation",
    "seedance",
    "seedance-2",
    "long-video",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "video-continuation",
    "video-extension",
    "storyboard",
    "ffmpeg",
    "new-api",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "README.en.md",
    "MetaOnticVideo使用说明书.md",
    "MetaOnticVideo使用说明书.pdf",
    "CHANGELOG.md",
    "LICENSE",
    "docs/guide/*.svg",
    "docs/guide/*.png",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "hyperframes": "0.8.223",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "node scripts/build.mjs locale",
    "build:host": "node scripts/build.mjs host",
    "build:client": "node scripts/build.mjs client",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "release": "node scripts/release.mjs",
    "clean:releases": "node scripts/clean-releases.mjs",
    "pack:test": "node scripts/pack-test.mjs"
  },
  "dependencies": {},
  "releaseNotes": {
    "version": "3.13.12",
    "prerelease": false,
    "publishedAt": "2026-11-03T07:58:38.456Z",
    "items": [
      "优化：脚本设计阶段的耗时统计改由插件自动结束——完整脚本保存为 script.md 后自动闭合该段计时并写入 script_saved 日志，不再依赖模型手动调用结束，阶段耗时统计更准确；脚本不是用写文件工具保存时仍按原方式补结束。",
      "修复：发布时 Gitee 上传成品包偶发 HTTP 400 会让整次发布中断；现在失败会带出服务端返回正文，先复查附件表是否已收完，再按退避自动重试，减少人工重跑。",
      "优化：新增维护者清理命令 npm run clean:releases（默认只演练），按同一份计划回收两个仓库的历史标签、发行版与发行版附件，最新正式版始终保留；并配套每周演练工作流，只有确认后才真正删除。"
    ]
  }
}
