{
  "name": "metaontic-video",
  "version": "3.13.5",
  "description": "AI video creation plugin for DeepSeek Harness: Seedance 2.0 long videos with multi-segment continuation, text-to-video, image-to-video, script and storyboard review, segment previews, resumable generation and local FFmpeg merging.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "metaontic-video",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "ai-video",
    "ai-video-generation",
    "seedance",
    "seedance-2",
    "long-video",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "video-continuation",
    "video-extension",
    "storyboard",
    "ffmpeg",
    "new-api",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "README.en.md",
    "MetaOnticVideo使用说明书.md",
    "MetaOnticVideo使用说明书.pdf",
    "CHANGELOG.md",
    "LICENSE",
    "docs/guide/*.svg",
    "docs/guide/*.png",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "hyperframes": "0.8.223",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "node scripts/build.mjs locale",
    "build:host": "node scripts/build.mjs host",
    "build:client": "node scripts/build.mjs client",
    "build": "npm run typecheck && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {},
  "releaseNotes": {
    "version": "3.13.5",
    "prerelease": false,
    "publishedAt": "2026-11-02T08:12:08.079Z",
    "items": [
      "新增：Windows 安装说明新增“直接粘贴成品下载地址”的安装方式，压缩包教程里写出本版本真实的 Gitee 与 GitHub .tgz 附件地址，复制粘贴即可安装，不必先把文件下载到本机。",
      "优化：安装路径示例按真实解压结果修正（常见为两层同名文件夹），并建议右键 .tgz 选择“复制文件地址”获取完整路径，避免手打后填成文件夹路径。",
      "修复：安装指引中的下载入口统一为发布页地址，并说明 Gitee 的 releases/latest 会直接下载源码包、Source code 不是插件成品，避免把源码包当成安装文件。"
    ]
  }
}
