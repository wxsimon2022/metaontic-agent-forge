{
  "name": "metaontic-video",
  "version": "3.10.0-beta.1",
  "description": "DeepSeek Harness video creation plugin with a Video Creation Assistant for concepts, script review and confirmed production; supports reference images, video continuation, segment previews, resumable generation, local merging, and MetaOnticVideo, MetaOntic AI or Volcano Engine access.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "seedance",
    "video",
    "video-extension",
    "text-to-video",
    "ffmpeg",
    "new-api",
    "agent-preset",
    "video-director"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxsimon2022/metaontic-video.git"
  },
  "homepage": "https://github.com/wxsimon2022/metaontic-video#readme",
  "bugs": {
    "url": "https://github.com/wxsimon2022/metaontic-video/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "icon.svg",
    "logo.svg",
    "README.md",
    "MetaOnticVideo使用说明书.md",
    "MetaOnticVideo使用说明书.pdf",
    "CHANGELOG.md",
    "LICENSE",
    "docs/guide/*.svg",
    "docs/guide/*.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:locale": "esbuild scripts/build-locale.ts --format=esm --platform=node --packages=external --outfile=node_modules/.cache/build-locale.mjs --log-level=warning && node node_modules/.cache/build-locale.mjs",
    "build:host": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --packages=external --define:__PLUGIN_VERSION__=$(node -p 'JSON.stringify(require(\"./package.json\").version)') --outfile=index.js",
    "build:client": "esbuild src/client.ts --bundle --format=iife --platform=browser --target=es2022 --define:__PLUGIN_VERSION__=$(node -p 'JSON.stringify(require(\"./package.json\").version)') --outfile=client.js",
    "build": "npm run typecheck && npm run build:locale && npm run build:host && npm run build:client",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "hyperframes": "0.8.223"
  },
  "releaseNotes": {
    "version": "3.10.0-beta.1",
    "prerelease": true,
    "publishedAt": "2026-11-01T11:02:04Z",
    "items": [
      "新增：插件版本卡片支持切换正式版与预发布版渠道，确认后安装对应发布标签，并支持切回正式版。",
      "新增：发布默认采用 beta 预发布版本，增加版本号与预发布标记校验，双仓同步发布渠道。",
      "优化：配置保存等待设备同步及自动取回 Key 完成，冲突时绑定修订号安全重试，保留保存期间继续编辑的输入。",
      "优化：保存失败区分配置冲突、只读、页面失效及连接中断，增加不含密钥与字段值的诊断信息。",
      "优化：更新缓存按渠道隔离，切换后忽略旧查询结果，安装不回退默认分支、不先卸载插件；同步使用说明书与 PDF。",
      "修复：实际费用可空字段改用宿主支持的 Schema，解决“组件启动失败”导致插件无法加载。",
      "修复：重置后先核对配置并引导登录或填写 Key，保留脚本与任务进度，避免误建议重装或重启。"
    ]
  }
}
